# Copy to .env (gitignored) beside the compose file. Both variables are read by src/notify.js.
# Leave them unset to run approverr without notifications: it logs one warning at boot and carries on.

# The notification gateway's publish API, without a trailing path.
NOTIFY_URL=http://notify-gateway.example.lan:9160

# The publisher token this instance was issued. Never commit a real one.
NOTIFY_TOKEN=

# Optional: the host name that appears on a card. Defaults to the container's hostname.
# NOTIFY_HOST=
